rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read live scores; only the designated authenticated scorer can write.
    match /matches/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'X9GeuM5CnhOiOdaaIudizYWZocg2';
    }
  }
}
